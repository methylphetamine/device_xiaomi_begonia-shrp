package {
    default_applicable_licenses: ["system_extras_libfscryptcust_license"],
}

// Added automatically by a large-scale-change
// See: http://go/android-license-faq
license {
    name: "system_extras_libfscryptcust_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

cc_library {
    name: "libfscrypttwrp",
    // SHRP builds both the platform and recovery variants of libfs_mgr, so
    // this module must be available to both (unlike TWRP's recovery-only copy).
    srcs: [
        "fscrypt.cpp",
    ],
    export_include_dirs: ["include"],
    shared_libs: [
        "libbase",
        "libcutils",
        "libkeyutils",
        "liblogwrap",
    ],
}
